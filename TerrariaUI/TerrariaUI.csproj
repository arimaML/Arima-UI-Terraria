<Project Sdk="Microsoft.NET.Sdk" InitialTargets="CheckTMLPath">

	<!-- tModLoader location. Order: -p:TMLPath, then the TML_PATH environment variable, then
	     the default Steam install. Nothing author-specific is baked in. -->
	<PropertyGroup>
		<TMLPath Condition="'$(TMLPath)' == '' and '$(TML_PATH)' != ''">$(TML_PATH)</TMLPath>
		<TMLPath Condition="'$(TMLPath)' == '' and Exists('C:\Program Files (x86)\Steam\steamapps\common\tModLoader\tMLMod.targets')">C:\Program Files (x86)\Steam\steamapps\common\tModLoader</TMLPath>
	</PropertyGroup>

	<Import Project="$(TMLPath)\tMLMod.targets" Condition="'$(TMLPath)' != ''" />

	<Target Name="CheckTMLPath">
		<Error Condition="'$(TMLPath)' == ''"
		       Text="tModLoader not found. Set the TML_PATH environment variable or pass -p:TMLPath=&quot;&lt;folder containing tMLMod.targets&gt;&quot;." />
	</Target>

	<PropertyGroup>
		<AssemblyName>TerrariaUI</AssemblyName>
		<RootNamespace>TerrariaUI</RootNamespace>
		<Nullable>disable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ImplicitUsings>disable</ImplicitUsings>
		<!-- Filled in by tMLMod.targets only when it may package the mod; needed for
		     a compile-only pass (-p:BuildMod=false). -->
		<TargetFramework Condition="'$(TargetFramework)' == ''">net8.0</TargetFramework>
		<LangVersion Condition="'$(LangVersion)' == ''">12.0</LangVersion>
	</PropertyGroup>

	<!-- Compile-only mode: the targets attach game references only when they are also
	     allowed to package the .tmod, so mirror them here. -->
	<ItemGroup Condition="'$(BuildMod)' != 'true'">
		<Reference Include="$(tMLSteamPath)$(tMLPath)" Private="false" />
		<Reference Include="$(tMLLibraryPath)/**/*.dll" Private="false" />
		<Reference Remove="$(tMLLibraryPath)/Native/**" />
		<Reference Remove="$(tMLLibraryPath)/**/runtime*/**" />
		<Reference Remove="$(tMLLibraryPath)/**/*.resources.dll" />
		<Reference Remove="$(tMLLibraryPath)/tModCodeAssist/**" />
	</ItemGroup>

</Project>
