			}

			RealBlur: {
				Label: Реальное размытие
				Tooltip: Размывать мир за панелями (требует шейдерного прохода)
			}

			BlurStrength: {
				Label: Сила размытия
				Tooltip: Насколько сильно размывается фон под стеклом
			}

			PanelOpacity: {
				Label: Плотность панели
